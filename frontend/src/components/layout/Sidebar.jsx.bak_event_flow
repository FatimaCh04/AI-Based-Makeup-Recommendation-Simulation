import React from 'react';
import { NavLink, useLocation, useNavigate } from 'react-router-dom';
import {
  LayoutDashboard,
  ScanFace,
  Heart,
  History,
  UserCheck,
  Settings,
  LogOut,
  Sparkles,
  X,
  Palette,
  Info
} from 'lucide-react';
import { mockUserData } from '../../data/mockBeautyData';
import { useAuth } from '../../context/AuthContext';

export default function Sidebar({ isOpen, onClose }) {
  const location = useLocation();
  const navigate = useNavigate();
  const { user, logout } = useAuth();
  const displayName = user?.name || mockUserData.name;

  const navItems = [
    { name: 'Dashboard', path: '/dashboard', icon: LayoutDashboard },
    { name: 'Start Analysis', path: '/capture', icon: ScanFace, badge: 'AI' },
    { name: 'Saved Looks', path: '/saved-looks', icon: Heart },
    { name: 'Profile', path: '/profile', icon: UserCheck },
  ];

  const bottomItems = [
    { name: 'Settings', path: '/settings', icon: Settings },
  ];

  return (
    <>
      {/* Mobile Backdrop */}
      {isOpen && (
        <div
          className="fixed inset-0 z-40 bg-[#30232A]/40 backdrop-blur-xs lg:hidden"
          onClick={onClose}
        />
      )}

      {/* Main Sidebar Aside */}
      <aside
        className={`fixed top-0 left-0 z-50 h-screen w-64 bg-white border-r border-[#F8DCE5] flex flex-col justify-between transition-transform duration-300 ease-in-out lg:translate-x-0 ${
          isOpen ? 'translate-x-0' : '-translate-x-full'
        }`}
      >
        {/* Brand Header */}
        <div>
          <div className="flex items-center justify-between px-6 py-5 border-b border-[#F8DCE5]/60">
            <div
              onClick={() => navigate('/')}
              className="flex items-center gap-2.5 cursor-pointer"
            >
              <div className="w-8 h-8 rounded-xl bg-gradient-to-tr from-[#B92F60] to-[#C94D78] flex items-center justify-center text-white shadow-2xs">
                <Sparkles className="w-4 h-4" />
              </div>
              <div>
                <span className="text-base font-bold tracking-tight text-[#30232A] block leading-none">AI GLAM</span>
                <span className="text-[9px] uppercase tracking-wider text-[#B92F60] font-bold">Studio</span>
              </div>
            </div>

            <button
              onClick={onClose}
              className="lg:hidden p-1.5 rounded-xl text-[#30232A]/60 hover:bg-[#FFF1F5]"
              aria-label="Close sidebar"
            >
              <X className="w-4 h-4" />
            </button>
          </div>

          {/* Navigation Links */}
          <nav className="p-4 space-y-1">
            {navItems.map((item) => {
              const Icon = item.icon;
              const isActive = location.pathname === item.path;
              return (
                <NavLink
                  key={item.name}
                  to={item.path}
                  onClick={onClose}
                  className={`group flex items-center justify-between px-3.5 py-2.5 rounded-2xl text-xs font-semibold transition-all duration-200 ${
                    isActive
                      ? 'bg-[#B92F60] text-white shadow-xs'
                      : 'text-[#30232A]/80 hover:text-[#B92F60] hover:bg-[#FFF1F5]'
                  }`}
                >
                  <div className="flex items-center gap-3">
                    <Icon
                      className={`w-4 h-4 transition-transform duration-200 group-hover:scale-110 ${
                        isActive ? 'text-white' : 'text-[#30232A]/50 group-hover:text-[#B92F60]'
                      }`}
                    />
                    <span>{item.name}</span>
                  </div>

                  {item.badge && (
                    <span
                      className={`text-[9px] px-1.5 py-0.5 rounded-full font-bold ${
                        isActive
                          ? 'bg-white/20 text-white'
                          : 'bg-[#F8DCE5] text-[#B92F60]'
                      }`}
                    >
                      {item.badge}
                    </span>
                  )}
                </NavLink>
              );
            })}
          </nav>
        </div>

        {/* Sidebar Footer & User Profile */}
        <div className="p-4 border-t border-[#F8DCE5]/60 space-y-2 bg-[#FFF1F5]/40">
          {bottomItems.map((item) => {
            const Icon = item.icon;
            const isActive = location.pathname === item.path;
            return (
              <NavLink
                key={item.name}
                to={item.path}
                onClick={onClose}
                className={`group flex items-center gap-3 px-3.5 py-2 rounded-2xl text-xs font-semibold transition-all duration-200 ${
                  isActive
                    ? 'bg-[#F8DCE5] text-[#B92F60] font-bold'
                    : 'text-[#30232A]/70 hover:text-[#B92F60] hover:bg-[#FFF1F5]'
                }`}
              >
                <Icon className="w-4 h-4 text-[#30232A]/50 group-hover:text-[#B92F60]" />
                <span>{item.name}</span>
              </NavLink>
            );
          })}

          <button
            onClick={() => {
              if (onClose) onClose();
              logout();
              navigate('/login');
            }}
            className="w-full flex items-center gap-3 px-3.5 py-2 rounded-2xl text-xs font-semibold text-[#30232A]/70 hover:text-rose-600 hover:bg-rose-50 transition-all duration-200 text-left"
          >
            <LogOut className="w-4 h-4 text-[#30232A]/50 group-hover:text-rose-600" />
            <span>Logout</span>
          </button>

          {/* User Account Card */}
          <div
            onClick={() => {
              if (onClose) onClose();
              navigate('/profile');
            }}
            className="mt-2 p-2.5 rounded-2xl bg-white border border-[#F8DCE5] shadow-2xs hover:border-[#B92F60] transition-all cursor-pointer flex items-center gap-3"
          >
            <img
              src={mockUserData.avatar}
              alt={displayName}
              className="w-8 h-8 rounded-full object-cover ring-1 ring-[#F8DCE5]"
            />
            <div className="min-w-0 flex-1">
              <div className="text-xs font-bold text-[#30232A] truncate">{displayName}</div>
              <div className="text-[10px] text-[#B92F60] font-semibold">View Profile</div>
            </div>
          </div>
        </div>
      </aside>
    </>
  );
}
