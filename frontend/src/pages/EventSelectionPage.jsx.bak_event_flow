import React from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import { ArrowLeft, Sparkles, Gem, Briefcase, Sun, Heart, Palette, ArrowRight, UserCheck } from 'lucide-react';
import { mockEventTypes } from '../data/mockBeautyData';

export default function EventSelectionPage() {
  const navigate = useNavigate();
  const location = useLocation();
  const searchParams = new URLSearchParams(location.search);
  const isGuest = searchParams.get('mode') === 'guest' || location.state?.isGuest;

  const getEventIcon = (id) => {
    switch (id) {
      case 'wedding':
        return <Gem className="w-6 h-6 text-[#B92F60]" />;
      case 'party':
        return <Sparkles className="w-6 h-6 text-[#C94D78]" />;
      case 'office':
        return <Briefcase className="w-6 h-6 text-[#30232A]" />;
      case 'casual':
        return <Sun className="w-6 h-6 text-[#D97706]" />;
      case 'date-night':
        return <Heart className="w-6 h-6 text-[#B92F60]" />;
      case 'other':
        return <Palette className="w-6 h-6 text-[#C94D78]" />;
      default:
        return <Sparkles className="w-6 h-6 text-[#B92F60]" />;
    }
  };

  const handleSelectEvent = (event) => {
    sessionStorage.setItem('glamai_guest_occasion', event.name);
    navigate('/capture', { state: { selectedEvent: event, isGuest } });
  };

  return (
    <div className="max-w-5xl mx-auto space-y-8 pb-12 font-sans text-[#30232A]">
      {/* Top Header Row with Back Button */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div className="flex items-center gap-4">
          <button
            onClick={() => isGuest ? navigate('/') : navigate('/dashboard')}
            className="p-2.5 rounded-2xl bg-white border border-[#F8DCE5] text-[#30232A] hover:bg-[#FFF1F5] hover:text-[#B92F60] transition-colors shadow-2xs"
            aria-label="Go Back"
          >
            <ArrowLeft className="w-5 h-5" />
          </button>
          <div>
            <h1 className="text-xl sm:text-2xl font-serif font-bold text-[#30232A] tracking-tight">
              Select Your Event
            </h1>
            <p className="text-xs sm:text-sm text-[#30232A]/60">
              We will recommend the best makeup style and finish for the occasion.
            </p>
          </div>
        </div>

        {isGuest && (
          <div className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#FFF1F5] border border-[#F8DCE5] text-xs font-semibold text-[#B92F60] self-start sm:self-auto">
            <UserCheck className="w-3.5 h-3.5" />
            <span>Guest Mode Active</span>
          </div>
        )}
      </div>

      {/* 6 Event Cards Grid */}
      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {mockEventTypes.map((event) => (
          <div
            key={event.id}
            onClick={() => handleSelectEvent(event)}
            className="group relative p-6 rounded-3xl bg-white border border-[#F8DCE5] shadow-xs hover:shadow-sm hover:border-[#B92F60] transition-all duration-300 cursor-pointer flex flex-col justify-between space-y-4 transform hover:-translate-y-0.5"
          >
            <div className="space-y-3">
              {/* Icon Circle */}
              <div className="w-13 h-13 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] flex items-center justify-center shadow-2xs transition-transform duration-300 group-hover:scale-105">
                {getEventIcon(event.id)}
              </div>

              {/* Event Name */}
              <div>
                <h3 className="text-base font-bold text-[#30232A] group-hover:text-[#B92F60] transition-colors flex items-center justify-between">
                  <span>{event.name}</span>
                  <ArrowRight className="w-4 h-4 text-[#B92F60] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all" />
                </h3>
              </div>

              {/* Subtypes bullet list */}
              <div className="space-y-1 pt-1">
                {event.subtypes.map((sub, idx) => (
                  <div key={idx} className="text-xs text-[#30232A]/60 flex items-center gap-1.5">
                    <span className="w-1.5 h-1.5 rounded-full bg-[#B92F60]" />
                    <span>{sub}</span>
                  </div>
                ))}
              </div>
            </div>

            {/* Bottom Select Action */}
            <div className="pt-3 border-t border-[#F8DCE5]/60 flex items-center justify-between">
              <span className="text-xs font-semibold text-[#30232A]/70 group-hover:text-[#B92F60] transition-colors">
                Choose {event.name}
              </span>
              <span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#FFF1F5] text-[#B92F60] border border-[#F8DCE5]">
                AI Ready
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
