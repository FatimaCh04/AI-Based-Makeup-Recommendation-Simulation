import React, { useState, useEffect, useCallback } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import {
  Sparkles, PlusCircle, Bookmark, Trash2, Eye, Droplets,
  Palette, CircleDot, Sun, AlertCircle, ArrowRight, UserCheck,
  RefreshCw, Check, Heart
} from 'lucide-react';
import { useAuth } from '../context/AuthContext';
import { apiClient } from '../services/apiClient';

export default function DashboardPage() {
  const navigate = useNavigate();
  const { user } = useAuth();

  const [savedLooks, setSavedLooks] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [deleteId, setDeleteId] = useState(null);
  const [showSkinGuideModal, setShowSkinGuideModal] = useState(false);

  // Fetch actual saved looks for this authenticated user
  const fetchSavedLooks = useCallback(async () => {
    setLoading(true);
    setError('');
    try {
      const res = await apiClient.get('/user/saved-looks');
      if (res.data && Array.isArray(res.data.looks)) {
        setSavedLooks(res.data.looks);
      }
    } catch (err) {
      console.warn('Could not load saved looks:', err);
      setError('Unable to load saved looks from the database. Please try again.');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchSavedLooks();
  }, [fetchSavedLooks]);

  // Delete a saved look
  const handleDeleteLook = async (lookId) => {
    if (!window.confirm('Are you sure you want to delete this saved look?')) return;
    try {
      await apiClient.delete(`/user/saved-looks/${lookId}`);
      setSavedLooks(prev => prev.filter(look => look.id !== lookId));
    } catch (err) {
      alert('Could not remove look. Please try again.');
    }
  };

  // View a saved look
  const handleViewLook = (look) => {
    if (look.thumbnail) {
      sessionStorage.setItem('glamai_guest_image', look.thumbnail);
    }
    if (look.event) {
      sessionStorage.setItem('glamai_guest_occasion', look.event);
    }
    if (look.time_of_day) {
      sessionStorage.setItem('glamai_guest_time', look.time_of_day);
    }
    if (look.analysis) {
      sessionStorage.setItem('glamai_guest_analysis', JSON.stringify(look.analysis));
    }
    if (look.shades) {
      sessionStorage.setItem('glamai_guest_palette', JSON.stringify({ shades: look.shades }));
    }
    navigate('/result');
  };

  // Beauty profile from user record or session
  const beautyProfile = user?.beauty_profile || (() => {
    const sessionProfile = sessionStorage.getItem('glamai_guest_analysis');
    if (sessionProfile) {
      try { return JSON.parse(sessionProfile); } catch (e) {}
    }
    return null;
  })();

  const displayName = user?.name || 'Beauty Enthusiast';
  const firstName = displayName.split(' ')[0];

  return (
    <div className="space-y-6 pb-12 font-sans text-[#30232A]">
      {/* SECTION A: Welcome Section */}
      <section className="bg-white rounded-3xl border border-[#F8DCE5] p-6 sm:p-8 shadow-xs relative overflow-hidden">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
          <div className="space-y-1">
            <span className="text-[11px] font-bold uppercase tracking-wider text-[#B92F60] flex items-center gap-1.5">
              <Sparkles className="w-3.5 h-3.5" />
              Member Studio
            </span>
            <h1 className="text-2xl sm:text-3xl font-serif font-bold text-[#30232A]">
              Welcome Back, {firstName}!
            </h1>
            <p className="text-xs sm:text-sm text-[#30232A]/70">
              Continue exploring your personalized makeup looks.
            </p>
          </div>

          <div className="flex items-center gap-3">
            <button
              onClick={() => navigate('/capture')}
              className="px-5 py-2.5 rounded-2xl bg-[#B92F60] hover:bg-[#C94D78] text-white text-xs sm:text-sm font-bold shadow-xs transition-all active:scale-95 flex items-center gap-2"
            >
              <PlusCircle className="w-4 h-4" />
              <span>Create New Look</span>
            </button>
          </div>
        </div>
      </section>

      {/* SECTION D: Quick Actions (Placed right below welcome for convenience) */}
      <section className="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <button
          onClick={() => navigate('/capture')}
          className="p-4 rounded-2xl bg-white border border-[#F8DCE5] hover:border-[#B92F60] text-left transition-all shadow-2xs group"
        >
          <div className="w-9 h-9 rounded-xl bg-[#FFF1F5] text-[#B92F60] flex items-center justify-center mb-2 group-hover:scale-105 transition-transform">
            <PlusCircle className="w-4 h-4" />
          </div>
          <p className="text-xs font-bold text-[#30232A] group-hover:text-[#B92F60] transition-colors">
            Create New Look
          </p>
          <p className="text-[10px] text-[#30232A]/60">AI Camera or Upload</p>
        </button>

        <a
          href="#saved-looks-section"
          className="p-4 rounded-2xl bg-white border border-[#F8DCE5] hover:border-[#B92F60] text-left transition-all shadow-2xs group"
        >
          <div className="w-9 h-9 rounded-xl bg-[#FFF1F5] text-[#B92F60] flex items-center justify-center mb-2 group-hover:scale-105 transition-transform">
            <Bookmark className="w-4 h-4" />
          </div>
          <p className="text-xs font-bold text-[#30232A] group-hover:text-[#B92F60] transition-colors">
            My Saved Looks
          </p>
          <p className="text-[10px] text-[#30232A]/60">{savedLooks.length} Saved Looks</p>
        </a>

        <button
          onClick={() => navigate('/profile')}
          className="p-4 rounded-2xl bg-white border border-[#F8DCE5] hover:border-[#B92F60] text-left transition-all shadow-2xs group"
        >
          <div className="w-9 h-9 rounded-xl bg-[#FFF1F5] text-[#B92F60] flex items-center justify-center mb-2 group-hover:scale-105 transition-transform">
            <UserCheck className="w-4 h-4" />
          </div>
          <p className="text-xs font-bold text-[#30232A] group-hover:text-[#B92F60] transition-colors">
            My Beauty Profile
          </p>
          <p className="text-[10px] text-[#30232A]/60">Skin &amp; Facial Metrics</p>
        </button>

        <button
          onClick={() => setShowSkinGuideModal(true)}
          className="p-4 rounded-2xl bg-white border border-[#F8DCE5] hover:border-[#B92F60] text-left transition-all shadow-2xs group"
        >
          <div className="w-9 h-9 rounded-xl bg-[#FFF1F5] text-[#B92F60] flex items-center justify-center mb-2 group-hover:scale-105 transition-transform">
            <Droplets className="w-4 h-4" />
          </div>
          <p className="text-xs font-bold text-[#30232A] group-hover:text-[#B92F60] transition-colors">
            Skin Guide
          </p>
          <p className="text-[10px] text-[#30232A]/60">Pre-Makeup Guidance</p>
        </button>
      </section>

      {/* SECTION B: Beauty Profile Summary */}
      <section className="bg-white rounded-3xl border border-[#F8DCE5] p-5 sm:p-6 shadow-xs">
        <div className="flex items-center justify-between pb-3 border-b border-[#F8DCE5] mb-4">
          <div className="flex items-center gap-2">
            <Sparkles className="w-4 h-4 text-[#B92F60]" />
            <h2 className="text-base sm:text-lg font-serif font-bold text-[#30232A]">
              Beauty Profile Summary
            </h2>
          </div>
          <button
            onClick={() => navigate('/capture')}
            className="text-xs font-semibold text-[#B92F60] hover:underline flex items-center gap-1"
          >
            <span>{beautyProfile ? 'Re-Analyze Features' : 'Analyze Features'}</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </button>
        </div>

        {beautyProfile ? (
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5]">
              <div className="flex items-center justify-between text-xs text-[#30232A]/60 mb-1">
                <span>Skin Tone</span>
                <Palette className="w-3.5 h-3.5 text-[#B92F60]" />
              </div>
              <p className="text-xs font-bold text-[#30232A]">{beautyProfile.skin_tone || 'Not available'}</p>
            </div>

            <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5]">
              <div className="flex items-center justify-between text-xs text-[#30232A]/60 mb-1">
                <span>Undertone</span>
                <Sun className="w-3.5 h-3.5 text-[#B92F60]" />
              </div>
              <p className="text-xs font-bold text-[#30232A]">{beautyProfile.undertone || 'Not available'}</p>
            </div>

            <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5]">
              <div className="flex items-center justify-between text-xs text-[#30232A]/60 mb-1">
                <span>Skin Type</span>
                <Droplets className="w-3.5 h-3.5 text-[#B92F60]" />
              </div>
              <p className="text-xs font-bold text-[#30232A]">{beautyProfile.skin_type || 'Not available'}</p>
            </div>

            <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5]">
              <div className="flex items-center justify-between text-xs text-[#30232A]/60 mb-1">
                <span>Face Shape</span>
                <CircleDot className="w-3.5 h-3.5 text-[#B92F60]" />
              </div>
              <p className="text-xs font-bold text-[#30232A]">{beautyProfile.face_shape || 'Not available'}</p>
            </div>
          </div>
        ) : (
          <div className="p-6 rounded-2xl bg-[#FFF1F5] border border-dashed border-[#F8DCE5] text-center space-y-2">
            <p className="text-xs text-[#30232A]/70">
              No beauty profile analyzed yet. Take a quick photo scan to detect your skin tone and facial structure.
            </p>
            <button
              onClick={() => navigate('/capture')}
              className="px-4 py-2 rounded-xl bg-[#B92F60] hover:bg-[#C94D78] text-white text-xs font-semibold shadow-2xs"
            >
              Analyze Your Features
            </button>
          </div>
        )}
      </section>

      {/* SECTION C: My Saved Looks */}
      <section id="saved-looks-section" className="bg-white rounded-3xl border border-[#F8DCE5] p-5 sm:p-6 shadow-xs space-y-4">
        <div className="flex items-center justify-between pb-3 border-b border-[#F8DCE5]">
          <div className="flex items-center gap-2">
            <Bookmark className="w-4 h-4 text-[#B92F60]" />
            <h2 className="text-base sm:text-lg font-serif font-bold text-[#30232A]">
              My Saved Looks
            </h2>
          </div>
          <span className="text-xs text-[#30232A]/60">
            {savedLooks.length} {savedLooks.length === 1 ? 'Look' : 'Looks'}
          </span>
        </div>

        {/* Loading State */}
        {loading && (
          <div className="py-8 text-center text-xs text-[#30232A]/60 flex items-center justify-center gap-2">
            <RefreshCw className="w-4 h-4 animate-spin text-[#B92F60]" />
            <span>Loading your saved looks...</span>
          </div>
        )}

        {/* Error State */}
        {!loading && error && (
          <div className="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-xs text-rose-700 flex items-center gap-2">
            <AlertCircle className="w-4 h-4 flex-shrink-0" />
            <span>{error}</span>
          </div>
        )}

        {/* Empty State */}
        {!loading && !error && savedLooks.length === 0 && (
          <div className="py-12 px-4 rounded-2xl bg-[#FFF1F5]/60 border border-dashed border-[#F8DCE5] text-center max-w-md mx-auto space-y-3">
            <div className="w-12 h-12 rounded-full bg-white border border-[#F8DCE5] flex items-center justify-center mx-auto text-[#B92F60]">
              <Heart className="w-5 h-5" />
            </div>
            <div>
              <h3 className="text-sm font-bold text-[#30232A]">No saved looks yet</h3>
              <p className="text-xs text-[#30232A]/60 mt-0.5">
                Create your first makeup look to see it here.
              </p>
            </div>
            <button
              onClick={() => navigate('/capture')}
              className="px-5 py-2.5 rounded-2xl bg-[#B92F60] hover:bg-[#C94D78] text-white text-xs font-bold shadow-xs transition-all inline-flex items-center gap-1.5"
            >
              <PlusCircle className="w-3.5 h-3.5" />
              <span>Create Your First Look</span>
            </button>
          </div>
        )}

        {/* Saved Looks Cards Grid */}
        {!loading && !error && savedLooks.length > 0 && (
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {savedLooks.map((look) => (
              <div
                key={look.id}
                className="bg-[#FFF1F5]/50 border border-[#F8DCE5] rounded-2xl overflow-hidden hover:shadow-sm transition-all group"
              >
                {/* Thumbnail */}
                <div className="relative aspect-[4/3] bg-[#F8DCE5] overflow-hidden">
                  {look.thumbnail ? (
                    <img
                      src={look.thumbnail}
                      alt={look.title}
                      className="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
                    />
                  ) : (
                    <div className="w-full h-full flex items-center justify-center text-xs text-[#30232A]/40 font-semibold">
                      No Preview
                    </div>
                  )}

                  <span className="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full bg-white/90 backdrop-blur-xs text-[10px] font-bold text-[#B92F60] shadow-2xs">
                    {look.event || 'Custom'}
                  </span>

                  {look.time_of_day && (
                    <span className="absolute top-2.5 right-2.5 px-2 py-0.5 rounded-full bg-[#30232A]/75 text-[10px] font-semibold text-white">
                      {look.time_of_day}
                    </span>
                  )}
                </div>

                {/* Details */}
                <div className="p-3.5 space-y-2">
                  <div className="flex items-center justify-between">
                    <h3 className="text-xs font-bold text-[#30232A] truncate">
                      {look.title || `${look.event} Look`}
                    </h3>
                    {look.date && (
                      <span className="text-[10px] text-[#30232A]/50 whitespace-nowrap">{look.date}</span>
                    )}
                  </div>

                  {/* Actions (View Look & Delete) */}
                  <div className="flex items-center gap-2 pt-1 border-t border-[#F8DCE5]/60">
                    <button
                      onClick={() => handleViewLook(look)}
                      className="flex-1 py-1.5 px-2 rounded-xl bg-white border border-[#F8DCE5] hover:border-[#B92F60] text-xs font-semibold text-[#B92F60] flex items-center justify-center gap-1 transition-colors shadow-2xs"
                    >
                      <Eye className="w-3 h-3" />
                      <span>View Look</span>
                    </button>

                    <button
                      onClick={() => handleDeleteLook(look.id)}
                      title="Delete look"
                      className="p-1.5 rounded-xl border border-[#F8DCE5] hover:bg-rose-50 text-[#30232A]/60 hover:text-rose-600 transition-colors"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      {/* Skin Guide Modal */}
      {showSkinGuideModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-xs">
          <div className="w-full max-w-md bg-white rounded-3xl border border-[#F8DCE5] p-6 shadow-xl space-y-4">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2">
                <Droplets className="w-4 h-4 text-[#B92F60]" />
                <h3 className="text-base font-bold text-[#30232A]">Personalized Skin Guide</h3>
              </div>
              <button
                onClick={() => setShowSkinGuideModal(false)}
                className="text-xs text-[#30232A]/60 hover:text-[#30232A] p-1"
              >
                ✕
              </button>
            </div>

            <div className="p-4 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] space-y-2 text-xs text-[#30232A]/80">
              <p className="font-bold text-[#B92F60]">
                Skin Type: {beautyProfile?.skin_type || 'Combination'}
              </p>
              <p>• <strong>Hydration Prep:</strong> Apply lightweight serum before applying foundation.</p>
              <p>• <strong>Primer Selection:</strong> Use pore-blurring primer on high-movement facial zones.</p>
              <p>• <strong>Application:</strong> Blend outwards with a damp beauty sponge for seamless finish.</p>
              <p className="text-[10px] text-[#30232A]/50 italic pt-1">
                General cosmetic prep advice; not medical diagnosis.
              </p>
            </div>

            <button
              onClick={() => setShowSkinGuideModal(false)}
              className="w-full py-2.5 rounded-2xl bg-[#B92F60] text-white text-xs font-bold"
            >
              Close Guide
            </button>
          </div>
        </div>
      )}
    </div>
  );
}
