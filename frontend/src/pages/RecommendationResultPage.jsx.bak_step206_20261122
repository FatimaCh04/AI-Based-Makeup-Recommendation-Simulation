import React, { useState, useEffect } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import {
  ArrowLeft, Sparkles, Heart, Palette, Droplets, Check,
  ChevronDown, ChevronUp, Info, ScanFace, User, Layers,
  Circle, Eye as EyeIcon, BadgeCheck, Download
} from 'lucide-react';
import BeforeAfterSlider from '../components/common/BeforeAfterSlider';
import { useAuth } from '../context/AuthContext';
import { apiClient } from '../services/apiClient';
import {
  applyFoundationToCanvas,
  applyLipstickToCanvas,
  applyBlushToCanvas,
  applyEyeshadowToCanvas,
  applyEyelinerToCanvas,
  applyMascaraToCanvas,
  applyHighlighterToCanvas,
  getCachedLandmarks
} from '../utils/virtualMakeupEngine';

const CAT = {
  Foundation:  { emoji: '🧴' },
  Lipstick:    { emoji: '💄' },
  Eyeshadow:   { emoji: '👁️' },
  Blush:       { emoji: '🌸' },
  Eyeliner:    { emoji: '✏️' },
  Mascara:     { emoji: '✨' },
  Highlighter: { emoji: '💫' },
};

function PRow({ icon: Icon, label, value, swatch }) {
  return (
    <div className="flex items-center justify-between py-1.5 border-b border-[#F8DCE5]/50 last:border-0 gap-2">
      <span className="flex items-center gap-1.5 text-[11px] text-[#30232A]/50 font-medium">
        <Icon className="w-3 h-3 text-[#B92F60] flex-shrink-0" />{label}
      </span>
      <span className="flex items-center gap-1.5 text-[11px] font-bold text-[#30232A]">
        {swatch && <span className="w-3 h-3 rounded-full border border-black/10 flex-shrink-0" style={{ backgroundColor: swatch }} />}
        {value || '—'}
      </span>
    </div>
  );
}

export default function RecommendationResultPage() {
  const navigate            = useNavigate();
  const location            = useLocation();
  const { isAuthenticated } = useAuth();

  const [saved,          setSaved]          = useState(false);
  const [saveError,      setSaveError]      = useState('');
  const [showSkinGuide,  setShowSkinGuide]  = useState(false);
  const [simulatedImage, setSimulatedImage] = useState(null);
  const [expandedShade,  setExpandedShade]  = useState(null);

  const capturedImage =
    location.state?.capturedImage ||
    sessionStorage.getItem('glamai_guest_image') ||
    'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=80';

  const selectedEvent = location.state?.selectedEvent || {
    name: sessionStorage.getItem('glamai_guest_occasion') || 'Party',
    id:   'party',
  };

  const analysis = (() => {
    if (location.state?.analysis) return location.state.analysis;
    const s = sessionStorage.getItem('glamai_guest_analysis');
    if (s) try { return JSON.parse(s); } catch {}
    return { face_shape:'Oval', skin_tone:'Medium', skin_tone_hex:'#D8A782',
             undertone:'Warm', skin_type:'Normal', eye_shape:'Almond',
             nose_characteristics:'Straight', lip_shape:'Medium' };
  })();

  const recommendation = (() => {
    if (location.state?.recommendation) return location.state.recommendation;
    const s = sessionStorage.getItem('glamai_recommendation');
    if (s) try { return JSON.parse(s); } catch {}
    return null;
  })();

  const eventLabel = selectedEvent.name || 'Makeup';
  const pageTitle  = `Your ${eventLabel} Makeup Look`;
  const shades     = recommendation?.shades || [];

  useEffect(() => {
    if (!capturedImage) return;
    const foundHex = recommendation?.shade_map?.foundation?.hex ||
      recommendation?.shades?.find(s => s.category?.toLowerCase() === 'foundation')?.hex ||
      analysis?.skin_tone_hex || '#D8A782';
    const foundFinish = recommendation?.shades?.find(s => s.category?.toLowerCase() === 'foundation')?.finish || 'Satin Dewy';

    const blushHex = recommendation?.shade_map?.blush?.hex ||
      recommendation?.shades?.find(s => s.category?.toLowerCase() === 'blush')?.hex ||
      '#D37D64';
    const blushFinish = recommendation?.shades?.find(s => s.category?.toLowerCase() === 'blush')?.finish || 'Luminous';

    const highHex = recommendation?.shade_map?.highlighter?.hex ||
      recommendation?.shades?.find(s => s.category?.toLowerCase() === 'highlighter')?.hex ||
      '#EAD5A6';
    const highFinish = recommendation?.shades?.find(s => s.category?.toLowerCase() === 'highlighter')?.finish || 'Radiant Luminous';

    const eyeHex = recommendation?.shade_map?.eyeshadow?.hex ||
      recommendation?.shades?.find(s => s.category?.toLowerCase() === 'eyeshadow')?.hex ||
      '#8F5E43';
    const eyeFinish = recommendation?.shades?.find(s => s.category?.toLowerCase() === 'eyeshadow')?.finish || 'Shimmer';

    const linerHex = recommendation?.shade_map?.eyeliner?.hex ||
      recommendation?.shades?.find(s => s.category?.toLowerCase() === 'eyeliner')?.hex ||
      '#1A1A1A';
    const linerName  = recommendation?.shades?.find(s => s.category?.toLowerCase() === 'eyeliner')?.name || '';
    const linerStyle = linerName.toLowerCase().includes('wing') ? 'Winged' : 'Classic';

    const mascaraHex = recommendation?.shade_map?.mascara?.hex ||
      recommendation?.shades?.find(s => s.category?.toLowerCase() === 'mascara')?.hex ||
      '#101010';
    const mascaraVolume = recommendation?.shades?.find(s => s.category?.toLowerCase() === 'mascara')?.finish || 'volumizing';

    const lipHex = recommendation?.shade_map?.lipstick?.hex ||
      recommendation?.shades?.find(s => s.category?.toLowerCase() === 'lipstick')?.hex ||
      '#B92F60';
    const lipFinish = recommendation?.shades?.find(s => s.category?.toLowerCase() === 'lipstick')?.finish || 'Satin';

    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      const c = document.createElement('canvas');
      c.width = img.naturalWidth || 600;
      c.height = img.naturalHeight || 750;
      const ctx = c.getContext('2d');
      ctx.drawImage(img, 0, 0, c.width, c.height);

      const landmarks = getCachedLandmarks(analysis, capturedImage, 'member');

      if (landmarks) {
        const faceShape = analysis?.face_shape || 'Oval';

        // 1. Face-aware Foundation (Base Complexion Layer)
        applyFoundationToCanvas(ctx, c.width, c.height, landmarks, {
          hex: foundHex,
          coverage: 'medium',
          finish: foundFinish,
          opacity: 0.48
        });

        // 2. Face-aware Blush (Face-shape customized)
        applyBlushToCanvas(ctx, c.width, c.height, landmarks, {
          hex: blushHex,
          finish: blushFinish,
          opacity: 0.55,
          faceShape
        });

        // 3. Face-aware Highlighter (Face-shape customized)
        applyHighlighterToCanvas(ctx, c.width, c.height, landmarks, {
          hex: highHex,
          finish: highFinish,
          opacity: 0.50,
          faceShape
        });

        // 4. Face-aware Eyeshadow
        applyEyeshadowToCanvas(ctx, c.width, c.height, landmarks, {
          hex: eyeHex,
          finish: eyeFinish,
          opacity: 0.65
        });

        // 5. Face-aware Eyeliner
        applyEyelinerToCanvas(ctx, c.width, c.height, landmarks, {
          hex: linerHex,
          style: linerStyle,
          opacity: 0.90,
          thickness: 1.8
        });

        // 6. Face-aware Mascara
        applyMascaraToCanvas(ctx, c.width, c.height, landmarks, {
          hex: mascaraHex,
          volume: mascaraVolume,
          opacity: 0.92
        });

        // 7. Face-aware Lipstick
        applyLipstickToCanvas(ctx, c.width, c.height, landmarks, {
          hex: lipHex,
          finish: lipFinish,
          opacity: 0.62
        });
      } else {
        console.warn('[GlamAI] Facial landmarks unavailable for member simulation');
      }

      setSimulatedImage(c.toDataURL('image/jpeg', 0.92));
    };
    img.src = capturedImage;
  }, [capturedImage, recommendation, analysis]);

  const handleDownload = () => {
    const targetImg = simulatedImage || capturedImage;
    if (!targetImg) return;
    const link = document.createElement('a');
    link.href = targetImg;
    link.download = `glamai-${(selectedEvent.name || 'look').toLowerCase().replace(/[^a-z0-9]/g, '-')}-result.jpg`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  const handleSave = async () => {
    if (!isAuthenticated) { navigate('/login'); return; }
    setSaveError('');
    try {
      await apiClient.post('/user/saved-looks', {
        title: pageTitle, event: selectedEvent.name, thumbnail: capturedImage,
        analysis, shades: recommendation?.shade_map || {},
        palette_name: recommendation?.look_name || pageTitle,
      });
      setSaved(true); setTimeout(() => setSaved(false), 3000);
    } catch { setSaveError('Could not save. Please try again.'); }
  };

  return (
    <div className="max-w-6xl mx-auto pb-10 font-sans text-[#30232A] space-y-4">

      {/* ── HEADER ──────────────────────────────────────────────────── */}
      <div className="flex items-center justify-between gap-3">
        <div className="flex items-center gap-3 min-w-0">
          <button
            onClick={() => navigate('/select-event', { state: { capturedImage, analysis } })}
            className="flex-shrink-0 w-9 h-9 rounded-2xl bg-white border border-[#F8DCE5] hover:bg-[#FFF1F5] hover:border-[#B92F60]/40 transition-all shadow-sm flex items-center justify-center"
          >
            <ArrowLeft className="w-4 h-4" />
          </button>
          <div className="min-w-0">
            <div className="flex items-center gap-2 flex-wrap">
              <h1 className="text-base sm:text-xl font-serif font-bold text-[#30232A] leading-tight">{pageTitle}</h1>
              <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#FFF1F5] border border-[#F8DCE5] text-[10px] font-bold text-[#B92F60]">
                <BadgeCheck className="w-3 h-3" /> AI Matched
              </span>
            </div>
            <p className="text-[11px] text-[#30232A]/50 mt-0.5">
              Personalized for <span className="font-semibold text-[#B92F60]">{analysis.skin_tone}</span> skin · <span className="font-semibold text-[#B92F60]">{analysis.undertone}</span> undertones
            </p>
          </div>
        </div>
        <div className="flex items-center gap-2">
          <button
            onClick={handleDownload}
            className="flex-shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-2xl text-xs font-bold border border-[#F8DCE5] bg-white text-[#30232A] hover:bg-[#FFF1F5] hover:border-[#B92F60]/40 transition-all shadow-sm"
            title="Download simulated makeup look"
          >
            <Download className="w-3.5 h-3.5 text-[#B92F60]" /> Download
          </button>
          <button
            onClick={handleSave}
            className="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-2xl text-xs font-bold border transition-all shadow-sm"
            style={saved ? { background:'#B92F60', color:'#fff', borderColor:'#B92F60' } : { background:'#fff', color:'#B92F60', borderColor:'#F8DCE5' }}
          >
            {saved ? <><Check className="w-3.5 h-3.5" /> Saved!</> : <><Heart className="w-3.5 h-3.5" style={{ fill:'#B92F6025' }} /> Save Look</>}
          </button>
        </div>
      </div>
      {saveError && <p className="text-[11px] text-rose-500 text-right">{saveError}</p>}

      {/* ── COMPARISON + BEAUTY PROFILE ─────────────────────────────── */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-4 items-start">

        {/* Before/After */}
        <div className="lg:col-span-7 bg-white rounded-2xl border border-[#F8DCE5] shadow-sm overflow-hidden">
          <div className="flex items-center justify-between px-4 py-2.5 border-b border-[#F8DCE5]/60 bg-[#FFF9FB]">
            <p className="text-xs font-bold text-[#30232A]">Before &amp; After Comparison</p>
            <span className="text-[10px] text-[#30232A]/35">← Drag slider →</span>
          </div>
          <div className="p-3">
            <BeforeAfterSlider
              beforeImage={capturedImage}
              afterImage={simulatedImage || capturedImage}
              beforeLabel="Before"
              afterLabel={`After — ${eventLabel}`}
            />
          </div>
        </div>

        {/* Beauty Profile */}
        <div className="lg:col-span-5 bg-white rounded-2xl border border-[#F8DCE5] shadow-sm overflow-hidden">
          <div className="flex items-center gap-2 px-4 py-2.5 border-b border-[#F8DCE5]/60 bg-[#FFF9FB]">
            <div className="w-6 h-6 rounded-lg bg-[#FFF1F5] flex items-center justify-center">
              <ScanFace className="w-3.5 h-3.5 text-[#B92F60]" />
            </div>
            <div>
              <p className="text-xs font-bold text-[#30232A]">Your Beauty Profile</p>
              <p className="text-[10px] text-[#30232A]/40">AI-detected facial features</p>
            </div>
          </div>
          <div className="p-4 space-y-3">
            {/* Skin tone */}
            <div className="flex items-center gap-3 px-3 py-2.5 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5]">
              <div className="w-11 h-11 rounded-full border-2 border-white shadow-md flex-shrink-0"
                   style={{ background:`radial-gradient(circle at 38% 35%,${(analysis.skin_tone_hex||'#D8A782')}CC,${analysis.skin_tone_hex||'#C9875A'})` }} />
              <div>
                <p className="text-[10px] text-[#30232A]/45 font-medium">Skin Tone</p>
                <p className="text-sm font-black text-[#30232A] leading-tight">{analysis.skin_tone || '—'}</p>
                {analysis.skin_tone_hex && <p className="text-[9px] font-mono text-[#B92F60]">{analysis.skin_tone_hex.toUpperCase()}</p>}
              </div>
            </div>
            {/* Attributes */}
            <div>
              <PRow icon={User}     label="Face Shape" value={analysis.face_shape} />
              <PRow icon={Droplets} label="Undertone"  value={analysis.undertone}  />
              <PRow icon={Layers}   label="Skin Type"  value={analysis.skin_type}  />
              <PRow icon={EyeIcon}  label="Eye Shape"  value={analysis.eye_shape}  />
              <PRow icon={Circle}   label="Lip Shape"  value={analysis.lip_shape}  />
            </div>
            {/* Note */}
            <div className="flex items-start gap-2 px-3 py-2 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5]">
              <Sparkles className="w-3 h-3 text-[#B92F60] flex-shrink-0 mt-0.5" />
              <p className="text-[11px] text-[#B92F60] leading-relaxed">
                Shades selected for <strong>{analysis.skin_tone?.toLowerCase()}</strong> skin &amp; <strong>{analysis.undertone?.toLowerCase()}</strong> undertones.
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* ── RECOMMENDED MAKEUP SHADES ───────────────────────────────── */}
      {shades.length > 0 && (
        <div className="bg-white rounded-2xl border border-[#F8DCE5] shadow-sm overflow-hidden">
          {/* Header */}
          <div className="flex items-center justify-between px-4 py-2.5 border-b border-[#F8DCE5]/60 bg-[#FFF9FB]">
            <div>
              <h2 className="text-sm font-serif font-bold text-[#30232A]">Recommended Makeup Shades</h2>
              {recommendation?.description && (
                <p className="text-[10px] text-[#30232A]/45 mt-0.5">{recommendation.description}</p>
              )}
            </div>
            <span className="hidden sm:flex items-center gap-1 px-2.5 py-1 rounded-full bg-[#FFF1F5] border border-[#F8DCE5] text-[10px] font-bold text-[#B92F60]">
              <Sparkles className="w-3 h-3" /> {recommendation?.look_name || eventLabel}
            </span>
          </div>

          {/* Shade cards — compact uniform grid */}
          <div className="p-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-2.5">
            {shades.map((shade, idx) => {
              const meta      = CAT[shade.category] || { emoji: '🎨' };
              const isOpen    = expandedShade === idx;
              const shadeName = shade.name || shade.shade || '—';
              const hex       = shade.hex || '#D8A782';

              return (
                <div key={idx} className="rounded-xl border border-[#F8DCE5] bg-white hover:border-[#B92F60]/40 hover:shadow-sm transition-all overflow-hidden flex flex-col">
                  {/* Swatch */}
                  <div className="h-10 w-full flex-shrink-0 relative" style={{ backgroundColor: hex }}>
                    <span className="absolute top-1.5 left-2 text-xs leading-none">{meta.emoji}</span>
                    <span className="absolute bottom-1 right-1.5 text-[8px] font-mono text-white/80 bg-black/20 px-1 rounded leading-tight">{hex.toUpperCase()}</span>
                  </div>
                  {/* Body */}
                  <div className="p-2.5 flex flex-col gap-1 flex-1">
                    <p className="text-[9px] font-black uppercase tracking-wider leading-none text-[#B92F60]">{shade.category}</p>
                    <p className="text-[11px] font-bold text-[#30232A] leading-snug line-clamp-2">{shadeName}</p>
                    {shade.finish && <p className="text-[9px] text-[#30232A]/35 leading-none">{shade.finish}</p>}
                    {shade.why && (
                      <>
                        <button
                          type="button"
                          onClick={() => setExpandedShade(isOpen ? null : idx)}
                          className="mt-auto pt-1.5 border-t border-[#F8DCE5] flex items-center justify-between text-[9px] font-semibold text-[#B92F60]"
                        >
                          <span className="flex items-center gap-0.5"><Info className="w-2.5 h-2.5" /> Why?</span>
                          {isOpen ? <ChevronUp className="w-2.5 h-2.5" /> : <ChevronDown className="w-2.5 h-2.5" />}
                        </button>
                        {isOpen && <p className="text-[9px] text-[#30232A]/60 leading-relaxed pt-1">{shade.why}</p>}
                      </>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* ── ACTION BUTTONS ──────────────────────────────────────────── */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <button
          onClick={() => navigate('/try-shades', { state: { capturedImage, selectedEvent } })}
          className="flex items-center justify-center gap-2 py-3 rounded-2xl text-white text-sm font-bold shadow-md transition-all active:scale-[0.98] hover:opacity-95"
          style={{ background:'linear-gradient(135deg,#B92F60,#C94D78)' }}
        >
          <Palette className="w-4 h-4" /> Try Different Shades
        </button>
        <button
          onClick={() => setShowSkinGuide(!showSkinGuide)}
          className="flex items-center justify-center gap-2 py-3 rounded-2xl bg-white border border-[#F8DCE5] text-[#B92F60] text-sm font-bold transition-all active:scale-[0.98] hover:bg-[#FFF1F5]"
        >
          <Droplets className="w-4 h-4" /> {showSkinGuide ? 'Hide Skin Guide' : 'View Skin Guide'}
        </button>
      </div>

      {/* ── SKIN GUIDE ──────────────────────────────────────────────── */}
      {showSkinGuide && (
        <div className="bg-white rounded-2xl border border-[#F8DCE5] shadow-sm overflow-hidden">
          <div className="flex items-center gap-2 px-4 py-2.5 border-b border-[#F8DCE5]/60 bg-[#FFF9FB]">
            <Droplets className="w-4 h-4 text-[#B92F60]" />
            <h3 className="text-sm font-serif font-bold text-[#30232A]">Skin Guide — {analysis.skin_type || 'Your'} Skin</h3>
          </div>
          <div className="p-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
            {[
              { step:'1. Prep',   text:`Apply hydrating toner and oil-balancing primer suited to your ${(analysis.skin_type||'Normal').toLowerCase()} skin.` },
              { step:'2. Apply', text:'Use a damp beauty sponge to press foundation for seamless blending.' },
              { step:'3. Set',   text:'Dust translucent powder on T-zone and finish with a dewy fixing mist.' },
            ].map(({ step, text }) => (
              <div key={step} className="p-3 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5] space-y-1">
                <p className="text-xs font-bold text-[#B92F60]">{step}</p>
                <p className="text-[11px] text-[#30232A]/65 leading-relaxed">{text}</p>
              </div>
            ))}
          </div>
        </div>
      )}

    </div>
  );
}
