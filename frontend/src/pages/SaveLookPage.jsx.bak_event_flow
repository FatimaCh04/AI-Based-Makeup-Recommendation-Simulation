import React, { useState } from 'react';
import { useNavigate, useLocation } from 'react-router-dom';
import { ArrowLeft, Heart, Sparkles, CheckCircle2 } from 'lucide-react';
import { mockEventTypes } from '../data/mockBeautyData';
import { apiClient } from '../services/apiClient';

export default function SaveLookPage() {
  const navigate = useNavigate();
  const location = useLocation();

  const [lookName, setLookName] = useState('Party Makeup Look');
  const [event, setEvent] = useState(location.state?.selectedEvent?.name || 'Party');
  const [notes, setNotes] = useState('Perfect for evening parties with soft berry lipstick and warm golden eye shimmer.');
  const [isSaving, setIsSaving] = useState(false);

  const previewImage = location.state?.capturedImage ||
    sessionStorage.getItem('glamai_guest_image') || null;

  const handleSave = async (e) => {
    e.preventDefault();
    setIsSaving(true);
    try {
      await apiClient.post('/user/saved-looks', {
        title: lookName,
        event: event,
        notes: notes,
        thumbnail: previewImage
      });
      navigate('/saved-looks');
    } catch (err) {
      console.warn('Could not save look to backend, navigating anyway:', err);
      navigate('/saved-looks');
    } finally {
      setIsSaving(false);
    }
  };

  return (
    <div className="max-w-4xl mx-auto space-y-6 pb-12 font-sans">
      
      {/* Top Header */}
      <div className="flex items-center gap-3">
        <button
          onClick={() => navigate('/result')}
          className="p-2.5 rounded-2xl bg-white border border-pink-200 text-charcoal-700 hover:bg-pink-50 transition-colors shadow-sm"
        >
          <ArrowLeft className="w-5 h-5" />
        </button>
        <div>
          <h1 className="text-2xl font-bold text-charcoal-900">Save This Look</h1>
          <p className="text-xs text-charcoal-500">Store this personalized AI simulation in your portfolio</p>
        </div>
      </div>

      {/* Save Look Form Card (Screen 11) */}
      <div className="p-6 sm:p-10 rounded-3xl bg-white border border-pink-100 shadow-soft grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        
        {/* Left Model Preview */}
        <div className="md:col-span-5 flex flex-col items-center">
          <div className="relative rounded-3xl overflow-hidden aspect-[4/5] w-full max-w-xs bg-charcoal-900 shadow-lg border-2 border-pink-200">
            <img src={previewImage} alt="Simulated Look" className="w-full h-full object-cover" />
            <span className="absolute bottom-3 left-3 bg-pink-600 text-white text-xs px-3 py-1 rounded-full font-bold shadow-md">
              {event} Style
            </span>
          </div>
        </div>

        {/* Right Form Fields */}
        <div className="md:col-span-7">
          <form onSubmit={handleSave} className="space-y-4">
            
            <div className="space-y-1.5">
              <label className="text-xs font-bold text-charcoal-700 uppercase tracking-wider">
                Look Name
              </label>
              <input
                type="text"
                required
                value={lookName}
                onChange={(e) => setLookName(e.target.value)}
                placeholder="e.g. Party Makeup Look"
                className="w-full px-4 py-2.5 rounded-2xl bg-ivory-50 border border-pink-200 text-xs sm:text-sm text-charcoal-900 focus:outline-none focus:ring-2 focus:ring-pink-400"
              />
            </div>

            <div className="space-y-1.5">
              <label className="text-xs font-bold text-charcoal-700 uppercase tracking-wider">
                Event
              </label>
              <select
                value={event}
                onChange={(e) => setEvent(e.target.value)}
                className="w-full px-4 py-2.5 rounded-2xl bg-ivory-50 border border-pink-200 text-xs sm:text-sm text-charcoal-900 focus:outline-none focus:ring-2 focus:ring-pink-400"
              >
                {mockEventTypes.map((evt) => (
                  <option key={evt.id} value={evt.name}>{evt.name}</option>
                ))}
              </select>
            </div>

            <div className="space-y-1.5">
              <label className="text-xs font-bold text-charcoal-700 uppercase tracking-wider">
                Notes (Optional)
              </label>
              <textarea
                rows={3}
                value={notes}
                onChange={(e) => setNotes(e.target.value)}
                placeholder="Add private styling notes..."
                className="w-full px-4 py-2.5 rounded-2xl bg-ivory-50 border border-pink-200 text-xs sm:text-sm text-charcoal-900 focus:outline-none focus:ring-2 focus:ring-pink-400"
              />
            </div>

            {/* Form Action Buttons (Screen 11 Bottom) */}
            <div className="flex items-center justify-end gap-3 pt-4 border-t border-pink-50">
              <button
                type="button"
                onClick={() => navigate('/result')}
                className="px-5 py-2.5 rounded-2xl bg-ivory-100 hover:bg-pink-50 text-charcoal-700 text-xs font-semibold transition-colors"
              >
                Cancel
              </button>

              <button
                type="submit"
                disabled={isSaving}
                className="px-6 py-2.5 rounded-2xl bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white text-xs font-bold shadow-berry-glow transition-all active:scale-95 disabled:opacity-50 flex items-center gap-1.5"
              >
                <Heart className="w-3.5 h-3.5 fill-white" />
                <span>{isSaving ? "Saving..." : "Save Look"}</span>
              </button>
            </div>

          </form>
        </div>

      </div>

    </div>
  );
}
