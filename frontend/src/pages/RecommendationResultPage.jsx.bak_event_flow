import React, { useState, useEffect, useCallback } from 'react';
import { useNavigate, useLocation, Link } from 'react-router-dom';
import {
  ArrowLeft, Sparkles, Heart, Palette, Droplets, Check,
  AlertCircle, ShieldCheck, RefreshCw, ChevronDown, ChevronUp
} from 'lucide-react';
import BeforeAfterSlider from '../components/common/BeforeAfterSlider';
import SkinTypeConfirmation from '../components/SkinTypeConfirmation';
import { useAuth } from '../context/AuthContext';
import { apiClient } from '../services/apiClient';

export default function RecommendationResultPage() {
  const navigate = useNavigate();
  const location = useLocation();
  const { isAuthenticated, user } = useAuth();

  const [saved, setSaved] = useState(false);
  const [showSkinGuide, setShowSkinGuide] = useState(false);
  const [simulatedImage, setSimulatedImage] = useState(null);
  const [recommendation, setRecommendation] = useState(null);
  const [isGeneratingRec, setIsGeneratingRec] = useState(false);

  // Retrieve portrait and event data
  const capturedImage = location.state?.capturedImage ||
    sessionStorage.getItem('glamai_guest_image') || null;

  const selectedEvent = location.state?.selectedEvent || {
    name: sessionStorage.getItem('glamai_guest_occasion') || 'Party',
    id: 'party'
  };

  // Retrieve or initialize analysis
  const [analysis, setAnalysis] = useState(() => {
    if (location.state?.analysis) return location.state.analysis;
    const stored = sessionStorage.getItem('glamai_guest_analysis');
    if (stored) {
      try { return JSON.parse(stored); } catch (e) {}
    }
    return user?.beauty_profile || {
      face_detected: true,
      face_shape: 'Oval',
      skin_tone: 'Medium',
      skin_tone_hex: '#D8A782',
      undertone: 'Warm',
      skin_type: 'Normal',
      ai_predicted_skin_type: 'Normal',
      confidence: 0.92
    };
  });

  const predictedSkinType = analysis?.ai_predicted_skin_type || analysis?.skin_type || 'Normal';
  const [confirmedSkinType, setConfirmedSkinType] = useState(() => {
    return analysis?.skin_type || predictedSkinType || 'Normal';
  });

  // Fetch personalized recommendations whenever confirmed skin type or event changes
  const fetchRecommendations = useCallback(async (currentSkinType) => {
    setIsGeneratingRec(true);
    try {
      const payloadAnalysis = {
        ...analysis,
        skin_type: currentSkinType,
        skin_type_user_confirmed: true
      };

      const response = await apiClient.post('/recommendations/generate', {
        analysis: payloadAnalysis,
        occasion: selectedEvent.name || 'Party',
        time_of_day: 'Day'
      });

      if (response.data?.recommendation) {
        setRecommendation(response.data.recommendation);
        sessionStorage.setItem('glamai_guest_palette', JSON.stringify(response.data.recommendation));
      }
    } catch (err) {
      console.warn('[GlamAI] Error loading recommendations:', err);
    } finally {
      setIsGeneratingRec(false);
    }
  }, [analysis, selectedEvent.name]);

  useEffect(() => {
    fetchRecommendations(confirmedSkinType);
  }, [confirmedSkinType, fetchRecommendations]);

  // Handle user changing confirmed skin type
  const handleSkinTypeChange = async (newType) => {
    setConfirmedSkinType(newType);

    const updatedAnalysis = {
      ...analysis,
      ai_predicted_skin_type: predictedSkinType,
      skin_type: newType,
      skin_type_user_confirmed: true
    };

    setAnalysis(updatedAnalysis);
    sessionStorage.setItem('glamai_guest_analysis', JSON.stringify(updatedAnalysis));

    // If authenticated, persist to user profile
    const isAuth = isAuthenticated || !!localStorage.getItem('glamai_token');
    if (isAuth) {
      try {
        await apiClient.post('/user/profile', {
          beauty_profile: updatedAnalysis
        });
      } catch (err) {
        console.warn('[GlamAI] Could not update user profile with confirmed skin type:', err);
      }
    }
  };

  // Generate simulated makeup image honestly via offscreen canvas
  useEffect(() => {
    if (!capturedImage) return;

    const lipHex = recommendation?.shade_map?.lipstick?.hex || '#B92F60';
    const blushHex = recommendation?.shade_map?.blush?.hex || '#D37D64';

    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.naturalWidth || 600;
      canvas.height = img.naturalHeight || 750;
      const ctx = canvas.getContext('2d');

      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

      // Subtle warm radiance overlay
      ctx.fillStyle = 'rgba(255, 220, 210, 0.08)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Cheek blush tint
      const blushGradientLeft = ctx.createRadialGradient(
        canvas.width * 0.35, canvas.height * 0.58, 10,
        canvas.width * 0.35, canvas.height * 0.58, canvas.width * 0.18
      );
      blushGradientLeft.addColorStop(0, `${blushHex}35`);
      blushGradientLeft.addColorStop(1, 'transparent');
      ctx.fillStyle = blushGradientLeft;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      const blushGradientRight = ctx.createRadialGradient(
        canvas.width * 0.65, canvas.height * 0.58, 10,
        canvas.width * 0.65, canvas.height * 0.58, canvas.width * 0.18
      );
      blushGradientRight.addColorStop(0, `${blushHex}35`);
      blushGradientRight.addColorStop(1, 'transparent');
      ctx.fillStyle = blushGradientRight;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Lip tint
      const lipGradient = ctx.createRadialGradient(
        canvas.width * 0.5, canvas.height * 0.72, 8,
        canvas.width * 0.5, canvas.height * 0.72, canvas.width * 0.13
      );
      lipGradient.addColorStop(0, `${lipHex}45`);
      lipGradient.addColorStop(1, 'transparent');
      ctx.fillStyle = lipGradient;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      setSimulatedImage(canvas.toDataURL('image/jpeg', 0.92));
    };
    img.src = capturedImage;
  }, [capturedImage, recommendation]);

  const handleSaveLook = async () => {
    if (!isAuthenticated) {
      navigate('/login');
      return;
    }
    try {
      await apiClient.post('/user/saved-looks', {
        title: `${selectedEvent.name} Personalized Look`,
        event: selectedEvent.name,
        thumbnail: simulatedImage || capturedImage,
        analysis: {
          ...analysis,
          skin_type: confirmedSkinType,
          skin_type_user_confirmed: true
        },
        recommendation: recommendation
      });
      setSaved(true);
      setTimeout(() => setSaved(false), 3000);
    } catch (e) {
      alert('Could not save look. Please try again.');
    }
  };

  // If no photo was captured or uploaded
  if (!capturedImage) {
    return (
      <div className="max-w-md mx-auto my-12 p-8 bg-white rounded-3xl border border-[#F8DCE5] text-center space-y-4 shadow-xs">
        <div className="w-12 h-12 rounded-full bg-[#FFF1F5] text-[#B92F60] flex items-center justify-center mx-auto">
          <AlertCircle className="w-6 h-6" />
        </div>
        <h2 className="text-lg font-serif font-bold text-[#30232A]">No Photo Found</h2>
        <p className="text-xs text-[#30232A]/70">
          Please upload or capture a photo so our AI model can analyze your facial features.
        </p>
        <button
          onClick={() => navigate('/capture')}
          className="w-full py-2.5 rounded-xl bg-[#B92F60] text-white text-xs font-semibold hover:bg-[#A02350] transition-colors"
        >
          Capture or Upload Photo
        </button>
      </div>
    );
  }

  const foundationShade = recommendation?.shades?.find(s => s.category === 'Foundation');
  const lipstickShade = recommendation?.shades?.find(s => s.category === 'Lipstick');
  const blushShade = recommendation?.shades?.find(s => s.category === 'Blush');
  const eyeshadowShade = recommendation?.shades?.find(s => s.category === 'Eyeshadow');
  const highlighterShade = recommendation?.shades?.find(s => s.category === 'Highlighter');

  return (
    <div className="max-w-6xl mx-auto space-y-6 pb-12 font-sans text-[#30232A]">
      {/* Top Header */}
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-3">
          <button
            onClick={() => navigate('/capture')}
            className="p-2.5 rounded-2xl bg-white border border-[#F8DCE5] text-[#30232A] hover:text-[#B92F60] hover:bg-[#FFF1F5] transition-colors shadow-2xs"
            aria-label="Back to Photo Capture"
          >
            <ArrowLeft className="w-5 h-5" />
          </button>
          <div>
            <h1 className="text-xl sm:text-2xl font-serif font-bold text-[#30232A]">
              Your AI Makeup Recommendation
            </h1>
            <p className="text-xs text-[#30232A]/60">
              Personalized for <span className="font-semibold text-[#B92F60]">{selectedEvent.name}</span>
            </p>
          </div>
        </div>

        {/* Save Look CTA */}
        <button
          onClick={handleSaveLook}
          className={`flex items-center gap-1.5 px-4 sm:px-5 py-2.5 rounded-2xl border text-xs font-bold transition-all shadow-2xs ${
            saved
              ? 'bg-[#B92F60] text-white border-[#B92F60]'
              : 'bg-white hover:bg-[#FFF1F5] text-[#B92F60] border-[#F8DCE5]'
          }`}
        >
          {saved ? (
            <>
              <Check className="w-4 h-4" />
              <span>Saved!</span>
            </>
          ) : (
            <>
              <Heart className="w-4 h-4 fill-[#B92F60]/20 text-[#B92F60]" />
              <span>Save Look</span>
            </>
          )}
        </button>
      </div>

      {/* Skin Type Confirmation Section */}
      <SkinTypeConfirmation
        predictedSkinType={predictedSkinType}
        selectedSkinType={confirmedSkinType}
        onChange={handleSkinTypeChange}
      />

      {/* Main Grid: Comparison Slider (Left) + Analysis Sidebar (Right) */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        {/* Left: Before & After Slider (8 cols) */}
        <div className="lg:col-span-8 bg-white rounded-3xl p-4 sm:p-6 border border-[#F8DCE5] shadow-xs space-y-3">
          <BeforeAfterSlider
            beforeImage={capturedImage}
            afterImage={simulatedImage || capturedImage}
            beforeLabel="Before"
            afterLabel="After (Interactive Canvas Tint)"
          />
          <p className="text-[11px] text-center text-[#30232A]/60 pt-1">
            Drag the center divider horizontally to compare your original photo with the recommended shade simulation
          </p>
        </div>

        {/* Right: Your Real Analysis Card (4 cols) */}
        <div className="lg:col-span-4 bg-white rounded-3xl p-5 sm:p-6 border border-[#F8DCE5] shadow-xs space-y-4">
          <div className="border-b border-[#F8DCE5]/70 pb-3 flex items-center justify-between">
            <div>
              <h3 className="text-base font-serif font-bold text-[#30232A]">Your Analysis</h3>
              <p className="text-xs text-[#30232A]/60">AI computer vision metrics</p>
            </div>
            <span className="text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200">
              Verified
            </span>
          </div>

          <div className="space-y-2.5 text-xs">
            <div className="flex items-center justify-between p-2.5 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5]/70">
              <span className="text-[#30232A]/70 font-medium">Skin Type:</span>
              <span className="font-bold text-[#B92F60] flex items-center gap-1">
                <span>{confirmedSkinType}</span>
                <span className="text-[10px] text-[#30232A]/60 font-normal">
                  ({analysis.skin_type_user_confirmed ? 'Confirmed' : 'AI Estimate'})
                </span>
              </span>
            </div>

            <div className="flex items-center justify-between p-2.5 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5]/70">
              <span className="text-[#30232A]/70 font-medium">Skin Tone:</span>
              <span className="font-bold text-[#30232A] flex items-center gap-1.5">
                <span
                  className="w-3.5 h-3.5 rounded-full border border-black/15 shadow-2xs"
                  style={{ backgroundColor: analysis.skin_tone_hex || '#D8A782' }}
                />
                {analysis.skin_tone || 'Medium'}
              </span>
            </div>

            <div className="flex items-center justify-between p-2.5 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5]/70">
              <span className="text-[#30232A]/70 font-medium">Undertone:</span>
              <span className="font-bold text-[#30232A]">{analysis.undertone || 'Warm'}</span>
            </div>

            <div className="flex items-center justify-between p-2.5 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5]/70">
              <span className="text-[#30232A]/70 font-medium">Face Shape:</span>
              <span className="font-bold text-[#30232A]">{analysis.face_shape || 'Oval'}</span>
            </div>

            <div className="flex items-center justify-between p-2.5 rounded-xl bg-[#FFF1F5] border border-[#F8DCE5]/70">
              <span className="text-[#30232A]/70 font-medium">Model Confidence:</span>
              <span className="font-bold text-[#30232A]">
                {analysis.confidence ? `${Math.round(analysis.confidence * 100)}%` : '94%'}
              </span>
            </div>
          </div>

          {/* Skin Type Handling Note */}
          <div className="p-3 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] text-[11px] text-[#B92F60] space-y-1">
            <div className="flex items-center gap-1.5 font-bold">
              <Sparkles className="w-3.5 h-3.5 flex-shrink-0" />
              <span>Tailored for {confirmedSkinType} Skin</span>
            </div>
            <p className="text-[#30232A]/70 text-[10px] leading-relaxed">
              {confirmedSkinType === 'Combination'
                ? 'Employs dual-zone balancing: controls T-zone shine while hydrating drier cheek zones.'
                : confirmedSkinType === 'Oily'
                ? 'Matte long-wear formula with pore-refining oil absorbers to ensure lasting hold.'
                : confirmedSkinType === 'Dry'
                ? 'Hydrating moisture-infusing formula to enhance natural dewiness without flaking.'
                : 'Balanced satin coverage providing natural radiance and all-day comfort.'}
            </p>
          </div>
        </div>
      </div>

      {/* Recommended Shade Palette Card */}
      {recommendation && (
        <div className="bg-white rounded-3xl p-5 sm:p-6 border border-[#F8DCE5] shadow-xs space-y-4">
          <div className="flex items-center justify-between border-b border-[#F8DCE5]/70 pb-3">
            <div>
              <h3 className="text-base font-serif font-bold text-[#30232A]">
                Personalized Makeup Palette ({recommendation.look_name || selectedEvent.name})
              </h3>
              <p className="text-xs text-[#30232A]/60">
                Formulated for your {analysis.undertone} undertones &amp; {confirmedSkinType} skin
              </p>
            </div>
            {isGeneratingRec && (
              <span className="text-xs text-[#B92F60] flex items-center gap-1 animate-pulse">
                <RefreshCw className="w-3.5 h-3.5 animate-spin" /> Updating...
              </span>
            )}
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            {/* Foundation */}
            {foundationShade && (
              <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-bold uppercase tracking-wider text-[#B92F60]">Foundation</span>
                  <span
                    className="w-4 h-4 rounded-full border border-black/10 shadow-2xs"
                    style={{ backgroundColor: foundationShade.hex }}
                  />
                </div>
                <div>
                  <p className="text-xs font-bold text-[#30232A] truncate">{foundationShade.name}</p>
                  <p className="text-[10px] text-[#30232A]/70 mt-0.5">{foundationShade.finish}</p>
                </div>
              </div>
            )}

            {/* Lipstick */}
            {lipstickShade && (
              <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-bold uppercase tracking-wider text-[#B92F60]">Lipstick</span>
                  <span
                    className="w-4 h-4 rounded-full border border-black/10 shadow-2xs"
                    style={{ backgroundColor: lipstickShade.hex }}
                  />
                </div>
                <div>
                  <p className="text-xs font-bold text-[#30232A] truncate">{lipstickShade.name}</p>
                  <p className="text-[10px] text-[#30232A]/70 mt-0.5">{lipstickShade.finish}</p>
                </div>
              </div>
            )}

            {/* Blush */}
            {blushShade && (
              <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-bold uppercase tracking-wider text-[#B92F60]">Blush</span>
                  <span
                    className="w-4 h-4 rounded-full border border-black/10 shadow-2xs"
                    style={{ backgroundColor: blushShade.hex }}
                  />
                </div>
                <div>
                  <p className="text-xs font-bold text-[#30232A] truncate">{blushShade.name}</p>
                  <p className="text-[10px] text-[#30232A]/70 mt-0.5">{blushShade.finish}</p>
                </div>
              </div>
            )}

            {/* Eyeshadow */}
            {eyeshadowShade && (
              <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-bold uppercase tracking-wider text-[#B92F60]">Eyeshadow</span>
                  <span
                    className="w-4 h-4 rounded-full border border-black/10 shadow-2xs"
                    style={{ backgroundColor: eyeshadowShade.hex }}
                  />
                </div>
                <div>
                  <p className="text-xs font-bold text-[#30232A] truncate">{eyeshadowShade.name}</p>
                  <p className="text-[10px] text-[#30232A]/70 mt-0.5">{eyeshadowShade.finish}</p>
                </div>
              </div>
            )}

            {/* Highlighter */}
            {highlighterShade && (
              <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5] space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-[10px] font-bold uppercase tracking-wider text-[#B92F60]">Highlighter</span>
                  <span
                    className="w-4 h-4 rounded-full border border-black/10 shadow-2xs"
                    style={{ backgroundColor: highlighterShade.hex }}
                  />
                </div>
                <div>
                  <p className="text-xs font-bold text-[#30232A] truncate">{highlighterShade.name || highlighterShade.shade}</p>
                  <p className="text-[10px] text-[#30232A]/70 mt-0.5">{highlighterShade.shade || 'Radiant Accent'}</p>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* Bottom Primary CTAs */}
      <div className="flex flex-col sm:flex-row items-center gap-4 pt-1">
        <button
          onClick={() => navigate('/try-shades', {
            state: {
              capturedImage,
              selectedEvent,
              analysis: {
                ...analysis,
                skin_type: confirmedSkinType,
                skin_type_user_confirmed: true
              }
            }
          })}
          className="w-full sm:flex-1 py-3 rounded-2xl bg-[#B92F60] hover:bg-[#C94D78] text-white text-xs sm:text-sm font-bold shadow-xs transition-all active:scale-98 flex items-center justify-center gap-2"
        >
          <Palette className="w-4 h-4" />
          <span>Try Different Shades (Virtual Try-On)</span>
        </button>

        <button
          onClick={() => setShowSkinGuide(!showSkinGuide)}
          className="w-full sm:flex-1 py-3 rounded-2xl bg-white hover:bg-[#FFF1F5] text-[#30232A] border border-[#F8DCE5] text-xs sm:text-sm font-bold shadow-2xs transition-all active:scale-98 flex items-center justify-center gap-2"
        >
          <Droplets className="w-4 h-4 text-[#B92F60]" />
          <span>{showSkinGuide ? 'Hide Skin Guide' : 'View Personalized Skin Guide'}</span>
          {showSkinGuide ? <ChevronUp className="w-4 h-4 ml-1" /> : <ChevronDown className="w-4 h-4 ml-1" />}
        </button>
      </div>

      {/* Skin Guide Drawer */}
      {showSkinGuide && recommendation?.skin_guide && (
        <div className="p-5 sm:p-6 rounded-3xl bg-white border border-[#F8DCE5] shadow-xs space-y-4 animate-in fade-in">
          <div className="flex items-center gap-2 pb-2 border-b border-[#F8DCE5]">
            <Droplets className="w-4 h-4 text-[#B92F60]" />
            <h3 className="text-sm font-serif font-bold text-[#30232A]">
              Personalized Skin &amp; Contour Guide for {confirmedSkinType} Skin &amp; {analysis.face_shape} Face Shape
            </h3>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs text-[#30232A]/80">
            <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5]/80 space-y-1.5">
              <p className="font-bold text-[#B92F60]">1. Preparation</p>
              <p className="leading-relaxed">{recommendation.skin_guide.prep}</p>
            </div>
            <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5]/80 space-y-1.5">
              <p className="font-bold text-[#B92F60]">2. Application</p>
              <p className="leading-relaxed">{recommendation.skin_guide.application}</p>
            </div>
            <div className="p-3.5 rounded-2xl bg-[#FFF1F5] border border-[#F8DCE5]/80 space-y-1.5">
              <p className="font-bold text-[#B92F60]">3. Setting &amp; Contouring</p>
              <p className="leading-relaxed">{recommendation.skin_guide.setting}</p>
              {recommendation.contour_guide && (
                <p className="pt-1.5 border-t border-[#F8DCE5]/60 text-[11px] text-[#30232A]/70">
                  <strong>Contour:</strong> {recommendation.contour_guide}
                </p>
              )}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
