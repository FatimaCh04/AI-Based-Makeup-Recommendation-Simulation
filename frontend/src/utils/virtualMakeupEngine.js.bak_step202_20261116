    const y205 = p205.y !== undefined ? p205.y : p205.pixel_y;
    const x425 = p425.x !== undefined ? p425.x : p425.pixel_x;
    const y425 = p425.y !== undefined ? p425.y : p425.pixel_y;
    const x234 = p234.x !== undefined ? p234.x : p234.pixel_x;
