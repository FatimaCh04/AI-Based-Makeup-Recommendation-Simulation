    const p362 = landmarks[362];  // Right eye medial canthus
    const p263 = landmarks[263];  // Right eye lateral canthus
    const p386 = landmarks[386];  // Right eye lashline apex
    const p257 = landmarks[257];  // Right eye crease apex

    if (!p33 || !p133 || !p159 || !p27 || !p362 || !p263 || !p386 || !p257) return false;

    const x33  = p33.x  !== undefined ? p33.x  : p33.pixel_x;
    const y33  = p33.y  !== undefined ? p33.y  : p33.pixel_y;
    const x133 = p133.x !== undefined ? p133.x : p133.pixel_x;
    const y133 = p133.y !== undefined ? p133.y : p133.pixel_y;
    const x362 = p362.x !== undefined ? p362.x : p362.pixel_x;
