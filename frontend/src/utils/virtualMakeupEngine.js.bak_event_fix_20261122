    if (!p33 || !p133 || !p159 || !p27 || !p362 || !p263 || !p386 || !p257) return false;

    const x33  = p33.x  !== undefined ? p33.x  : p33.pixel_x;
    const y33  = p33.y  !== undefined ? p33.y  : p33.pixel_y;
    const x133 = p133.x !== undefined ? p133.x : p133.pixel_x;
