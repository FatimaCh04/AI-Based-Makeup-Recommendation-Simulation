    if (!Number.isFinite(x33)  || !Number.isFinite(y33)  ||
        !Number.isFinite(x133) || !Number.isFinite(y133) ||
        !Number.isFinite(x362) || !Number.isFinite(y362) ||
        !Number.isFinite(x263) || !Number.isFinite(y263)) {
      return false;
    }

    // Verify non-degenerate eye width (> 1.5% of width or > 8px)
    const leftWidth = Math.abs(x133 - x33);
    const rightWidth = Math.abs(x263 - x362);

    if (x33 <= 1.5 && x133 <= 1.5) {
      if (leftWidth < 0.015 || rightWidth < 0.015) return false;
    } else {
      if (leftWidth < 8 || rightWidth < 8) return false;
    }
    return true;
  }
  return false;
