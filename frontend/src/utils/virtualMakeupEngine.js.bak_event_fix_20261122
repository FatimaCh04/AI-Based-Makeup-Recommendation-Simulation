/**
 * Parses hex color code into RGB components
 * @param {string} hex - e.g. '#B92F60' or 'B92F60'
 * @returns {{r: number, g: number, b: number}}
 */
export function hexToRgb(hex) {
  if (!hex || typeof hex !== 'string') {
    return { r: 185, g: 47, b: 96 }; // Default GlamAI berry
  }
  let cleanHex = hex.replace('#', '').trim();
  if (cleanHex.length === 3) {
    cleanHex = cleanHex.split('').map(c => c + c).join('');
  }
  const num = parseInt(cleanHex, 16);
  if (isNaN(num)) {
    return { r: 185, g: 47, b: 96 };
  }
  return {
    r: (num >> 16) & 255,
    g: (num >> 8) & 255,
    b: num & 255
  };
}

/**
 * Resolves a landmark point to absolute pixel coordinates on a canvas of width W and height H.
 * Handles both normalized {x, y} ([0, 1]) and pixel coordinates.
 */
function resolvePoint(pt, width, height) {
  if (!pt) return { x: 0, y: 0 };
  let x = pt.x !== undefined ? pt.x : pt.pixel_x;
  let y = pt.y !== undefined ? pt.y : pt.pixel_y;

  // If normalized (between 0 and 1.5)
  if (x <= 1.5 && y <= 1.5) {
    return { x: x * width, y: y * height };
  }
  return { x: Number(x), y: Number(y) };
}

/**
 * Computes a fast deterministic signature from an image source
 * to guarantee that cached landmarks are bound to the exact image raster.
 * @param {string|HTMLImageElement} imageSource
 * @returns {string}
 */
export function generateImageSignature(imageSource) {
  if (!imageSource) return '';
  const srcStr = typeof imageSource === 'string' ? imageSource : (imageSource.src || '');
  if (!srcStr) return '';

  if (srcStr.length > 200) {
    // For base64 / data URLs: length + sampled hash
    const len = srcStr.length;
    const sample = srcStr.slice(0, 80) +
                   srcStr.slice(Math.floor(len * 0.4), Math.floor(len * 0.4) + 60) +
                   srcStr.slice(-80);
    let hash = 5381;
    for (let i = 0; i < sample.length; i++) {
      hash = ((hash << 5) + hash) + sample.charCodeAt(i);
      hash |= 0;
    }
    return `sig_${len}_${Math.abs(hash).toString(36)}`;
  }
  return `url_${srcStr}`;
}

/**
 * Safely invalidates cached landmarks and analyses in sessionStorage.
 * Prevents stale landmarks from bleeding across photo uploads or auth contexts.
 * @param {'all'|'guest'|'member'} [context='all']
 */
export function invalidateLandmarkCache(context = 'all') {
  try {
    if (context === 'guest' || context === 'all') {
      sessionStorage.removeItem('glamai_guest_analysis');
      sessionStorage.removeItem('glamai_guest_palette');
      sessionStorage.removeItem('glamai_face_landmarks');
    }
    if (context === 'member' || context === 'all') {
      sessionStorage.removeItem('glamai_member_analysis');
      sessionStorage.removeItem('glamai_face_landmarks');
    }
  } catch (e) {
    console.warn('[GlamAI] Could not clear landmark cache:', e);
  }
}

/**
 * Validates whether the landmark dataset contains the necessary lip indices
 * and verifies that lip coordinates form a plausible non-degenerate facial feature.
 * @param {Array|Object} landmarks - MediaPipe 478 landmarks array or regions dictionary
 * @returns {boolean}
 */
export function validateLipLandmarks(landmarks) {
  if (!landmarks) return false;
  if (Array.isArray(landmarks)) {
    // Need at least 320 landmarks to cover lip indices up to 415
    if (landmarks.length < 320) return false;
    const p0 = landmarks[0];
    const p17 = landmarks[17];
    const p61 = landmarks[61];
    const p291 = landmarks[291];
    if (!p0 || !p17 || !p61 || !p291) return false;

    const x0 = p0.x !== undefined ? p0.x : p0.pixel_x;
    const y0 = p0.y !== undefined ? p0.y : p0.pixel_y;
    const x17 = p17.x !== undefined ? p17.x : p17.pixel_x;
    const y17 = p17.y !== undefined ? p17.y : p17.pixel_y;
    const x61 = p61.x !== undefined ? p61.x : p61.pixel_x;
    const x291 = p291.x !== undefined ? p291.x : p291.pixel_x;

    if (!Number.isFinite(x0) || !Number.isFinite(y0) ||
        !Number.isFinite(x17) || !Number.isFinite(y17) ||
        !Number.isFinite(x61) || !Number.isFinite(x291)) {
      return false;
    }

    // Guard against degenerate / zero-area lip geometry
    const lipWidth = Math.abs(x291 - x61);
    const lipHeight = Math.abs(y17 - y0);

    // If normalized coordinates [0, 1]
    if (x0 <= 1.5 && x291 <= 1.5) {
      if (lipWidth < 0.02 || lipHeight * 100 < 0.2) return false;
    } else {
      // If pixel coordinates
      if (lipWidth < 10 || lipHeight < 2) return false;
    }
    return true;
  }
  if (typeof landmarks === 'object' && landmarks.lips) {
    return Array.isArray(landmarks.lips.outer) && landmarks.lips.outer.length > 10;
  }
  return false;
}

/**
 * Validates whether the landmark dataset contains the necessary cheek indices
 * and verifies that bilateral cheek coordinates form a plausible facial geometry.
 * @param {Array|Object} landmarks - MediaPipe 478 landmarks array
 * @returns {boolean}
 */
export function validateCheekLandmarks(landmarks) {
  if (!landmarks) return false;
  if (Array.isArray(landmarks)) {
    if (landmarks.length < 455) return false;
    const p205 = landmarks[205];
    const p425 = landmarks[425];
    const p234 = landmarks[234];
    const p454 = landmarks[454];
    if (!p205 || !p425 || !p234 || !p454) return false;

    const x205 = p205.x !== undefined ? p205.x : p205.pixel_x;
    const y205 = p205.y !== undefined ? p205.y : p205.pixel_y;
    const x425 = p425.x !== undefined ? p425.x : p425.pixel_x;
    const y425 = p425.y !== undefined ? p425.y : p425.pixel_y;
    const x234 = p234.x !== undefined ? p234.x : p234.pixel_x;
    const x454 = p454.x !== undefined ? p454.x : p454.pixel_x;

    if (!Number.isFinite(x205) || !Number.isFinite(y205) ||
        !Number.isFinite(x425) || !Number.isFinite(y425) ||
        !Number.isFinite(x234) || !Number.isFinite(x454)) {
      return false;
    }

    // Verify distance between cheekbones is non-degenerate (> 6% of width)
    const cheekWidth = Math.abs(x454 - x234);
    if (x234 <= 1.5 && x454 <= 1.5) {
      if (cheekWidth < 0.06) return false;
    } else {
      if (cheekWidth < 25) return false;
    }
    return true;
  }
  return false;
}

