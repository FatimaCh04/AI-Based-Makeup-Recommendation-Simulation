      if (faceHeight < 0.10 || faceWidth < 0.08) return false;
    } else {
      if (faceHeight < 40 || faceWidth < 30) return false;
    }

    return validateLipLandmarks(landmarks) && validateCheekLandmarks(landmarks);
  }
  return false;
