    if (!p10 || !p152 || !p234 || !p454) return false;

    const x10  = p10.x  !== undefined ? p10.x  : p10.pixel_x;
    const y10  = p10.y  !== undefined ? p10.y  : p10.pixel_y;
    const x152 = p152.x !== undefined ? p152.x : p152.pixel_x;
    const y152 = p152.y !== undefined ? p152.y : p152.pixel_y;
    const x234 = p234.x !== undefined ? p234.x : p234.pixel_x;
    const y234 = p234.y !== undefined ? p234.y : p234.pixel_y;
    const x454 = p454.x !== undefined ? p454.x : p454.pixel_x;
    const y454 = p454.y !== undefined ? p454.y : p454.pixel_y;

    if (!Number.isFinite(x10)  || !Number.isFinite(y10)  ||
        !Number.isFinite(x152) || !Number.isFinite(y152) ||
        !Number.isFinite(x234) || !Number.isFinite(y234) ||
        !Number.isFinite(x454) || !Number.isFinite(y454)) {
      return false;
    }

    // Verify non-degenerate face height and width
    const faceHeight = Math.abs(y152 - y10);
    const faceWidth  = Math.abs(x454 - x234);

