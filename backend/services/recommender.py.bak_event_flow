    def _build_face_shape_advice(self):
        """
        Face-shape contouring and blush placement guidance.
        """
        self.face_shape_advice = {
            "Round": "Contour along the temples and diagonally beneath the cheekbones toward mouth corners to add structural definition. Sweep blush slightly upward toward the temples.",
            "Oval": "Apply soft contour along natural cheek hollows. Apply blush directly to the apples of the cheeks and blend outward for harmonious balance.",
            "Square": "Contour outer temple edges and soften the jawline angles with gentle shading. Apply blush in soft circular motions to soften cheek angles.",
            "Heart": "Contour sides of the forehead and the tip of the chin to soften width. Apply blush slightly lower on the apples of cheeks to draw focal harmony inward.",
            "Oblong": "Apply horizontal contour across the upper forehead hairline and bottom of the chin to visually balance length. Sweep blush horizontally outward."
