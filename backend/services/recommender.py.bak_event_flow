                "setting": "Lock in with a dewy, glycerin-based fixing mist. Avoid heavy powder; lightly dust micro-fine powder only under eyes if needed."
            },
            "Normal": {
                "day_finish": "Satin Natural Radiant",
                "night_finish": "Luminous Velvet",
                "prep": "Prep with a lightweight balanced daily moisturizer and illuminating skin-smoothing primer.",
                "application": "Apply satin liquid foundation using a buffing brush or sponge for seamless, buildable natural coverage.",
                "setting": "Dust a fine veil of translucent powder over the center of the face and set with a refreshing facial mist."
            },
            "Oily": {
                "day_finish": "Velvet Matte (Oil-Control)",
                "night_finish": "Long-Wear Soft Matte",
                "prep": "Cleanse thoroughly and apply an oil-free water-gel moisturizer followed by a pore-refining mattifying primer.",
