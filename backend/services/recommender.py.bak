    def get_recommendations(self, analysis_results, occasion="Party", time_of_day="Day"):
        """
        Generate recommendations for all requested items:
        Foundation, Lipstick, Eyeshadow, Blush, Eyeliner, Mascara, Highlighter.
        """
        skin_tone = analysis_results.get("skin_tone", "Medium")
        undertone = analysis_results.get("undertone", "Warm")
        face_shape = analysis_results.get("face_shape", "Oval")

        # Normalize inputs
        norm_occasion = "Casual" if "casual" in occasion.lower() else occasion.capitalize()
        if norm_occasion not in self.occasions:
            norm_occasion = "Party"

        is_night = str(time_of_day).lower() == "night"

        # 1. Foundation
        foundation = self.foundation_shades.get(skin_tone, self.foundation_shades["Medium"]).copy()
        foundation["category"] = "Foundation"
        foundation["finish"] = "Luminous Velvet" if is_night else foundation.get("finish", "Satin Natural")

        # 2. Lipstick
        lip_tone = self.lipstick_shades.get(skin_tone, self.lipstick_shades["Medium"])
        lip_under = lip_tone.get(undertone, lip_tone.get("Neutral", {}))
        lipstick = lip_under.get(norm_occasion, lip_under.get("Party", {})).copy()
        lipstick["category"] = "Lipstick"
        lipstick["finish"] = "Bold Satin" if is_night else "Velvet Cream"

        # 3. Eyeshadow
        eye_under = self.eyeshadow_shades.get(undertone, self.eyeshadow_shades["Neutral"])
        eyeshadow = eye_under.get(norm_occasion, eye_under.get("Party", {})).copy()
        eyeshadow["category"] = "Eyeshadow"
        eyeshadow["finish"] = "Deep Shimmer + Crease" if is_night else "Soft Matte"

        # 4. Blush
        blush_under = self.blush_shades.get(undertone, self.blush_shades["Neutral"])
        blush = blush_under.get(norm_occasion, blush_under.get("Party", {})).copy()
        blush["category"] = "Blush"
        blush["finish"] = "Radiant Luminous" if is_night else "Soft Matte"

        # 5. Eyeliner
        if is_night:
            eyeliner = {"category": "Eyeliner", "name": "Precision Wing", "shade": "Kohl Onyx", "hex": "#1A1A1A"}
        else:
            eyeliner = {"category": "Eyeliner", "name": "Soft Line Definition", "shade": "Espresso Brown" if undertone == "Warm" else "Slate Charcoal", "hex": "#3E2B24" if undertone == "Warm" else "#2F353B"}

        # 6. Mascara
        if is_night:
            mascara = {"category": "Mascara", "name": "Lash Drama Volumizing", "shade": "Jet Black", "hex": "#101010"}
        else:
            mascara = {"category": "Mascara", "name": "Featherlight Defined", "shade": "Deep Cocoa" if undertone == "Warm" else "Rich Black", "hex": "#251D19" if undertone == "Warm" else "#141414"}

        # 7. Highlighter
        if undertone == "Warm":
            highlighter = {"category": "Highlighter", "name": "Gilded Candlelight" if is_night else "Sunlit Golden Peach", "shade": "Champagne Glow", "hex": "#EAD5A6" if is_night else "#F3E3C3"}
        elif undertone == "Cool":
            highlighter = {"category": "Highlighter", "name": "Moonlit Pearl" if is_night else "Starlight Pink Glow", "shade": "Opal Frost", "hex": "#EEDBE2" if is_night else "#F5EBF0"}
        else:
            highlighter = {"category": "Highlighter", "name": "Silk Rose Radiance", "shade": "Rose Gold Glow", "hex": "#ECC4B6"}

        items = [foundation, lipstick, eyeshadow, blush, eyeliner, mascara, highlighter]

        # Look title
        display_event = "Casual / Daily Wear" if norm_occasion == "Casual" else norm_occasion
        time_label = "Night" if is_night else "Day"
        palette_title = f"{display_event} {time_label} Glow"

        return {
            "look_name": palette_title,
            "occasion": display_event,
            "time_of_day": time_label,
            "description": f"Tailored {time_label.lower()} look for {skin_tone.lower()} skin, {undertone.lower()} undertones, and {face_shape.lower()} facial structure.",
            "shades": items,
            "shade_map": {
                "foundation": {"name": foundation.get("name", "Foundation"), "hex": foundation.get("hex", "#D8A782")},
                "lipstick": {"name": lipstick.get("name", "Lipstick"), "hex": lipstick.get("hex", "#B92F60")},
                "eyeshadow": {"name": eyeshadow.get("name", "Eyeshadow"), "hex": eyeshadow.get("hex", "#A46638")},
                "blush": {"name": blush.get("name", "Blush"), "hex": blush.get("hex", "#D37D64")},
                "eyeliner": {"name": eyeliner.get("shade", "Eyeliner"), "hex": eyeliner.get("hex", "#1A1A1A")},
                "mascara": {"name": mascara.get("shade", "Mascara"), "hex": mascara.get("hex", "#101010")},
                "highlighter": {"name": highlighter.get("shade", "Highlighter"), "hex": highlighter.get("hex", "#EAD5A6")}
            }
        }
